# =============================================================================
# WebRTC SFU Environment Variables
# =============================================================================
# HTTP/REST endpoint
SFU_HTTP_ADDR=:8105

# Connect-RPC endpoint
SFU_RTC_ADDR=:8106

# NATS JetStream connection
SFU_NATS_URL=nats://nats:4222

# STUN servers (comma-separated)
SFU_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN server (optional)
# SFU_TURN_URL=turn:your-turn-server:3478
# SFU_TURN_USERNAME=your-username
# SFU_TURN_CREDENTIAL=your-credential

# Limits
SFU_MAX_PARTICIPANTS=50
SFU_MAX_ROOMS=1000
SFU_ROOM_TTL_SECS=3600

# Recording integration
SFU_RECORDING_HOOK_URL=http://recording-service:8093/v1/recordings/start

# OpenTelemetry endpoint
SFU_OTLP_ENDPOINT=http://otel-collector:4317

# Feature flags
SFU_ENABLE_CONNECT_RPC=true
SFU_ENABLE_REST=true
