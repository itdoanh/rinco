# =============================================================================
# Chat Engine Environment Variables
# =============================================================================
# HTTP/REST endpoint
CHAT_HTTP_ADDR=:8101

# Connect-RPC endpoint
CHAT_RPC_ADDR=:8102

# ScyllaDB connection (comma-separated for multiple nodes)
CHAT_SCYLLA_URL=scylla-node1,scylla-node2,scylla-node3
CHAT_SCYLLA_KEYSPACE=rinco_chat

# Valkey (Redis-compatible) connection
CHAT_VALKEY_URL=redis://valkey:6379

# NATS JetStream connection
CHAT_NATS_URL=nats://nats:4222

# OpenTelemetry endpoint
CHAT_OTLP_ENDPOINT=http://otel-collector:4317

# Feature flags
CHAT_ENABLE_CONNECT_RPC=true
CHAT_ENABLE_REST_FALLBACK=true

# Debug: Set to true for in-memory mode without external dependencies
CHAT_IN_MEMORY_MODE=false

# Timeouts
CHAT_SHUTDOWN_TIMEOUT_SECS=30
CHAT_HEARTBEAT_INTERVAL_SECS=30
CHAT_TYPING_TTL_SECS=5
CHAT_PRESENCE_TTL_SECS=90
CHAT_MAX_HISTORY_LIMIT=200
