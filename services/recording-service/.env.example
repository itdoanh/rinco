# =============================================================================
# Recording Service Environment Variables
# =============================================================================
# Server configuration
HOST=0.0.0.0
PORT=8093

# MinIO / S3 storage
MINIO_HOST=minio:9000
MINIO_USER=rinco
MINIO_PASSWORD=changeme
MINIO_SECURE=false
RECORDINGS_BUCKET=rinco-recordings

# Speech-to-Text service (optional)
STT_URL=http://stt-service:8097/v1/transcribe

# FFmpeg configuration
FFMPEG_BIN=ffmpeg
MAX_RECORDING_SECONDS=14400  # 4 hours

# Logging
LOG_LEVEL=INFO
