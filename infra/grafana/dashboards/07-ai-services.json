  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "AI SRE — RCA Latency (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_sre_analysis_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "ai-sre"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAG Chat — Tokens / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "sum(rate(rag_streaming_tokens_total[5m])) by (model)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Lead Scoring — Inference Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lead_scoring_inference_duration_seconds_bucket[5m])) by (model_version, le))",
          "legendFormat": "{{model_version}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "STT — Transcription Throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(transcribe_requests_total[5m])) by (language)",
          "legendFormat": "{{language}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Lead Score Distribution",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(lead_scoring_ensemble_score_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Hotfix PRs Created (24h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum(increase(ai_sre_hotfix_created_total[24h]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "AI SRE — Anomalies (current)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "value": null, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" }
      ] } } },
      "targets": [
        {
          "expr": "rinco_ai_sre_active_anomalies"
        }
      ]
    },
    {
      "id": 8,
      "title": "RAG Chat — Latency p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(rag_chat_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "title": "AI Inference Cost ($/hr)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "expr": "sum(rate(ai_inference_cost_usd_total[1h] * 3600)) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Lead Scoring — Score Distribution",
      "type": "heatmap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum(increase(lead_scoring_ensemble_score_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "RAG Chat — Embedder / LLM Tokens / sec",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        {
          "expr": "sum(rate(rag_streaming_tokens_total[5m])) by (model)",
          "legendFormat": "llm-{{model}}"
        },
        {
          "expr": "sum(rate(rag_embedder_tokens_total[5m])) by (model)",
          "legendFormat": "embed-{{model}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "AI SRE — Drift Detector Score",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "rinco_feature_drift_score",
          "legendFormat": "{{feature}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["rinco", "ai"],
  "templating": {
    "list": [
      {
        "name": "tenant_id",
