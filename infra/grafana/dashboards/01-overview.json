{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Requests / sec (by service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "expr": "sum(rate(rinco_http_requests_total[5m])) by (service)", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate %",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [
        { "value": null, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" }
      ] } } },
      "targets": [
        { "expr": "(sum(rate(rinco_http_requests_total{status=~\"5..\"}[5m])) by (service) / sum(rate(rinco_http_requests_total[5m])) by (service)) * 100",
          "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 3,
      "title": "p99 Latency (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(rinco_http_request_duration_seconds_bucket[5m])) by (service, route, le)) * 1000",
          "legendFormat": "{{service}} — {{route}}" }
      ]
    },
    {
      "id": 4,
      "title": "Active Tenants",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "rinco_active_tenants" }]
    },
    {
      "id": 5,
      "title": "Active Users",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "rinco_active_users" }]
    },
    {
      "id": 6,
      "title": "DB Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "pg_stat_activity_count", "legendFormat": "postgres" },
        { "expr": "valkey_connected_clients", "legendFormat": "valkey" },
        { "expr": "mongodb_ss_connections{conntype=\"current\"}", "legendFormat": "mongo" }
      ]
    },
    {
      "id": 7,
      "title": "System CPU %",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        { "expr": "rinco:node:cpu:utilization", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 8,
      "title": "Memory %",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        { "expr": "rinco:node:memory:utilization", "legendFormat": "{{instance}}" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["rinco", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "RINCO — System Overview",
  "uid": "rinco-overview",
  "version": 1,
  "weekStart": ""
}
