# Auto detect line endings
* text=auto

# Explicitly declare text files (let Git handle them)
*.sh          text eol=lf
*.bash        text eol=lf
*.ps1         text eol=crlf
*.psm1        text eol=crlf
*.psd1        text eol=crlf
*.yaml        text eol=lf
*.yml         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.toml        text eol=lf
*.go          text eol=lf
*.rs          text eol=lf
*.py          text eol=lf
*.tsx         text eol=lf
*.ts          text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf

# Declare files that will always be CRLF on Windows.
*.bat         text eol=crlf

# Declare binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.whl  binary
