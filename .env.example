# ===========================================
# RINCO Environment Variables Example
# ===========================================

# Application Environment
NODE_ENV=development
GO_ENV=development
RUST_ENV=development

# ===========================================
# Auth Service
# ===========================================
AUTH_HTTP_ADDR=:8081
AUTH_GRPC_ADDR=:9081
AUTH_DATABASE_URL=postgres://postgres:password@localhost:5432/auth
AUTH_VALKEY_URL=redis://localhost:6379
AUTH_VALKEY_PASSWORD=
AUTH_NATS_URL=nats://localhost:4222
AUTH_PASETO_KEY=<your-32-byte-hex-key>
AUTH_PASETO_PUBLIC=<your-32-byte-hex-public-key>
AUTH_JWT_SECRET=<your-jwt-secret>
AUTH_SESSION_SECRET=<your-session-secret>

# ===========================================
# Tenant Service
# ===========================================
TENANT_HTTP_ADDR=:8082
TENANT_GRPC_ADDR=:9082
TENANT_DATABASE_URL=postgres://postgres:password@localhost:5432/tenant
TENANT_NATS_URL=nats://localhost:4222

# ===========================================
# Lead Service
# ===========================================
LEAD_HTTP_ADDR=:8083
LEAD_GRPC_ADDR=:9083
LEAD_DATABASE_URL=postgres://postgres:password@localhost:5432/lead
LEAD_NATS_URL=nats://localhost:4222

# ===========================================
# CRM Service
# ===========================================
CRM_HTTP_ADDR=:8084
CRM_GRPC_ADDR=:9084
CRM_DATABASE_URL=postgres://postgres:password@localhost:5432/crm
CRM_NATS_URL=nats://localhost:4222

# ===========================================
# Landing Service
# ===========================================
LANDING_HTTP_ADDR=:8085
LANDING_GRPC_ADDR=:9085
LANDING_DATABASE_URL=postgres://postgres:password@localhost:5432/landing
LANDING_NATS_URL=nats://localhost:4222

# ===========================================
# Dynamic Model Service
# ===========================================
DYNAMIC_MODEL_HTTP_ADDR=:8086
DYNAMIC_MODEL_GRPC_ADDR=:9086
DYNAMIC_MODEL_DATABASE_URL=postgres://postgres:password@localhost:5432/dynamic_model
DYNAMIC_MODEL_NATS_URL=nats://localhost:4222

# ===========================================
# Chat Engine (Rust)
# ===========================================
CHAT_HTTP_ADDR=:8087
CHAT_WS_ADDR=:9087
CHAT_DATABASE_URL=postgres://postgres:password@localhost:5432/chat
CHAT_NATS_URL=nats://localhost:4222
CHAT_REDIS_URL=redis://localhost:6379

# ===========================================
# WebRTC SFU (Rust)
# ===========================================
WEBRTC_HTTP_ADDR=:8088
WEBRTC_WS_ADDR=:9088
WEBRTC_TURN_URL=turn:localhost:3478
WEBRTC_TURN_USERNAME=rinco
WEBRTC_TURN_PASSWORD=rinco123

# ===========================================
# Lead Scoring (Python)
# ===========================================
LEAD_SCORING_HOST=0.0.0.0
LEAD_SCORING_PORT=8089
LEAD_SCORING_DATABASE_URL=postgres://postgres:password@localhost:5432/lead_scoring
LEAD_SCORING_MODEL_PATH=/models/lead_scoring_v1.pkl

# ===========================================
# AI SRE Service
# ===========================================
AI_SRE_HTTP_ADDR=:8090
AI_SRE_DATABASE_URL=postgres://postgres:password@localhost:5432/ai_sre
AI_SRE_NATS_URL=nats://localhost:4222

# ===========================================
# RAG Chatbot Service
# ===========================================
RAG_HTTP_ADDR=:8091
RAG_DATABASE_URL=postgres://postgres:password@localhost:5432/rag
RAG_VECTOR_DB_URL=postgres://postgres:password@localhost:5432/vector_db
RAG_OPENAI_API_KEY=<your-openai-api-key>

# ===========================================
# STT Service
# ===========================================
STT_HTTP_ADDR=:8092
STT_MODEL_PATH=/models/whisper-base

# ===========================================
# Email Service
# ===========================================
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=hello@example.com
EMAIL_SMTP_PASSWORD=<your-smtp-password>
EMAIL_FROM=noreply@rinco.vn

# ===========================================
# Notification Service
# ===========================================
NOTIFICATION_HTTP_ADDR=:8093
NOTIFICATION_NATS_URL=nats://localhost:4222
NOTIFICATION_FIREBASE_KEY=<your-firebase-key>

# ===========================================
# Frontend - Landing Page
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
LANDING_PUBLIC_URL=http://localhost:3000

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=<your-meta-pixel-id>

# ===========================================
# Frontend - Admin Portal
# ===========================================
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:3001

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=<your-nextauth-secret>

# ===========================================
# Frontend - Tenant Site
# ===========================================
NEXT_PUBLIC_TENANT_API_URL=http://localhost:8080

# ===========================================
# Frontend - Meeting UI
# ===========================================
NEXT_PUBLIC_MEETING_API_URL=http://localhost:8080
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080/ws

# ===========================================
# Infrastructure
# ===========================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# NATS
NATS_HOST=localhost
NATS_PORT=4222
NATS_USER=nats
NATS_PASSWORD=nats123

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rinco

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===========================================
# Cloud Settings (Production)
# ===========================================

# Registry
REGISTRY=ghcr.io
REGISTRY_USERNAME=<your-github-username>

# Kubernetes
K8S_CLUSTER=<your-cluster-name>
K8S_NAMESPACE=production

# AWS (if using)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<your-aws-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret>

# Azure (if using)
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>

# GCP (if using)
GCP_PROJECT=<your-gcp-project>
GCP_CREDENTIALS=<path-to-credentials.json>
