# ============================================================
# RINCO — Environment Variables Example
# ===========================================
# Copy this file to .env and adjust for your environment.
# ===========================================

# Application Environment
NODE_ENV=development
GO_ENV=development
RUST_ENV=development

# ===========================================
# Cluster / Domain
# ===========================================
CLUSTER_NAME=rinco-local
REGION=ap-southeast-1
API_DOMAIN=api.rinco.vn
ADMIN_DOMAIN=admin.rinco.vn
LANDING_DOMAIN=landing.rinco.vn
TENANT_DOMAIN=tenants.rinco.vn
MEETING_DOMAIN=meeting.rinco.vn

# ===========================================
# Infrastructure Passwords (CHANGE FOR PROD)
# ===========================================
POSTGRES_PASSWORD=changeme
POSTGRES_USER=rinco
POSTGRES_DB=rinco
POSTGRES_PORT=5432

MONGO_USER=rinco
MONGO_PASSWORD=changeme
MONGO_DB=rinco
MONGO_PORT=27017

VALKEY_PASSWORD=changeme

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme

CLICKHOUSE_USER=rinco
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=rinco_analytics

MEILI_MASTER_KEY=changeme

NATS_USER=nats
NATS_PASSWORD=changeme

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ===========================================
# Auth Service
# ===========================================
AUTH_HTTP_ADDR=:8080
AUTH_GRPC_ADDR=:9080
AUTH_DATABASE_URL=postgres://rinco:changeme@postgres:5432/rinco
AUTH_VALKEY_URL=redis://valkey:6379
AUTH_NATS_URL=nats://nats:4222

# 32-byte (64 hex chars) PASETO symmetric key
AUTH_PASETO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_PASETO_PUBLIC=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

AUTH_JWT_SECRET=change-me-jwt-secret-32-bytes-long-padding-here
AUTH_SESSION_SECRET=change-me-session-secret

# ===========================================
# Meta CAPI
# ===========================================
META_APP_ID=000000000000000
META_APP_SECRET=change-me-meta-app-secret
META_HMAC_SECRET=change-me-hmac-secret
INGESTION_HMAC_SECRET=change-me-ingestion-hmac

# ===========================================
# Billing
# ===========================================
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
VNPAY_TMN_CODE=TST01
VNPAY_HASH_SECRET=change-me-vnpay-secret

# ===========================================
# AI Services
# ===========================================
OPENAI_API_KEY=sk-placeholder
HUGGINGFACE_TOKEN=hf-placeholder
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

LEAD_SCORING_HOST=0.0.0.0
LEAD_SCORING_PORT=8094

# ===========================================
# Notifications
# ===========================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@rinco.vn
SMTP_USER=noreply@rinco.local
SMTP_PASSWORD=changeme

FIREBASE_KEY=change-me-firebase-key

# ===========================================
# Frontends
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FB_PIXEL_ID=
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-nextauth-secret

# Cloud / Registry
# ===========================================
REGISTRY=ghcr.io
REGISTRY_USERNAME=rinco
