# ============================================================
# RINCO Environment Configuration
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ============================================================
# Authentication (PASETO + JWT keys)
# ============================================================
PASETO_KEY_CURRENT=                 # Hex-encoded 32-byte key: `openssl rand -hex 32`
PASETO_KEY_PREVIOUS=                # Previous key (overlap for rotation)
JWT_SIGNING_KEY=                    # Symmetric JWT secret (separate from PASETO)

# ============================================================
# Admin
# ============================================================
ADMIN_API_KEY=dev_admin_key_change_me

# ============================================================
# External services
# ============================================================
INGESTION_HMAC_SECRET=dev_secret_change_me
TURN_SECRET=dev_turn_secret
EXTERNAL_DNS_CF_API_KEY=            # Cloudflare API token

# ============================================================
# Notifications
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ============================================================
# AI / External APIs
# ============================================================
GITHUB_TOKEN=
GITHUB_REPO=itdoanh/rinco
NEXT_PUBLIC_FB_PIXEL_ID=

# ============================================================
# OpenAI / Embeddings (RAG)
# ============================================================
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ============================================================
# Stack — Database credentials (default: rinco_dev_password)
# ============================================================
POSTGRES_USER=rinco
POSTGRES_PASSWORD=rinco_dev_password
POSTGRES_DB=rinco
POSTGRES_REPLICA_PASSWORD=rinco_dev_password

SCYLLA_USER=cassandra
SCYLLA_PASSWORD=rinco_dev_password

CLICKHOUSE_USER=rinco
CLICKHOUSE_PASSWORD=rinco_dev_password
CLICKHOUSE_DB=rinco_analytics

MONGO_USER=rinco
MONGO_PASSWORD=rinco_dev_password
MONGO_DB=rinco

VALKEY_PASSWORD=rinco_dev_password

MEILI_MASTER_KEY=rinco_dev_password

MINIO_ROOT_USER=rinco
MINIO_ROOT_PASSWORD=rinco_dev_password

NATS_USER=rinco
NATS_PASSWORD=rinco_dev_password

# ============================================================
# Grafana / Prometheus
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# PagerDuty / Slack alert routing (production)
# ============================================================
PAGERDUTY_SERVICE_KEY=
PAGERDUTY_DBA_KEY=
SMTP_ALERT_PASSWORD=

# ============================================================
# Observability — OTel
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_always_on

# ============================================================
# WireGuard mesh
# ============================================================
WG_SERVER_PRIVATE_KEY=              # `wg genkey`
WG_SERVER_PUBLIC_KEY=               # `wg genkey | wg pubkey`
WG_SERVER_ENDPOINT=                  # e.g. mesh.rinco.app

# ============================================================
# Service URLs (docker-compose)
# ============================================================
LANDING_API_URL=http://landing-service:8086
ADMIN_API_URL=http://auth-service:8081
DASHBOARD_API_URL=http://observability-service:8089

# ============================================================
# Service-specific ports (override only if conflicts)
# ============================================================
AUTH_SERVICE_PORT=8081
TENANT_SERVICE_PORT=8082
CRM_SERVICE_PORT=8083
DYNAMIC_MODEL_SERVICE_PORT=8084
LEAD_SERVICE_PORT=8085
LANDING_SERVICE_PORT=8086
EMAIL_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
OBSERVABILITY_SERVICE_PORT=8089
AI_SRE_PORT=8090
RAG_CHATBOT_PORT=8091
LEAD_SCORING_PORT=8092
STT_SERVICE_PORT=8093
CHAT_ENGINE_PORT=8094
WEBRTC_SFU_PORT=8095
RECORDING_SERVICE_PORT=8096

# ============================================================
# Container/Cluster Tuning
# ============================================================
TZ=Asia/Ho_Chi_Minh
ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

GOMEMLIMIT=2048MiB
GOMAXPROCS=4
JAVA_OPTS=-Xms2g -Xmx4g
RUST_LOG=info

# ============================================================
# Secrets / Encryption
# ============================================================
ENCRYPTION_AT_REST_KEY=             # 32-byte key for pgcrypto / Scylla FPE

# ============================================================
# Feature flags
# ============================================================
RINCO_FEATURE_AI_SRE=true
RINCO_FEATURE_RAG_CHATBOT=true
RINCO_FEATURE_WEBRTC=true
RINCO_FEATURE_VOICE_STT=false       # Requires GPU

# ============================================================
# Local dev overrides
# ============================================================
COMPOSE_PROJECT_NAME=rinco
DEBUG=true
