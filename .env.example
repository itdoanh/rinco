# ============================================================
# RINCO Environment Configuration Example
# ============================================================
# Copy to .env and fill in your values

# ---------- Authentication ----------
PASETO_KEY_CURRENT=                 # Hex-encoded 32-byte key (use openssl rand -hex 32)
PASETO_KEY_PREVIOUS=                # Previous key for rotation overlap

# ---------- Admin ----------
ADMIN_API_KEY=dev_admin_key_change_me

# ---------- External Services ----------
INGESTION_HMAC_SECRET=dev_secret_change_me
TURN_SECRET=dev_turn_secret

# ---------- Notifications ----------
TELEGRAM_BOT_TOKEN=                 # Get from @BotFather
TELEGRAM_CHAT_ID=                    # Your chat ID
SLACK_WEBHOOK_URL=                   # Slack incoming webhook

# ---------- AI / External APIs ----------
GITHUB_TOKEN=                        # For AI SRE auto-PR
NEXT_PUBLIC_FB_PIXEL_ID=             # Facebook Pixel ID for landing

# ---------- Database (override defaults if needed) ----------
# DB_HOST=localhost
# DB_PASSWORD=rinco_dev_password

# ---------- Service URLs (for docker-compose networking) ----------
# LANDING_API_URL=http://landing-service:8086
# ADMIN_API_URL=http://auth-service:8081
