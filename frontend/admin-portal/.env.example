# RINCO Admin Portal — Super Admin Console
# =============================================================================
# NOTE: Admin API calls are routed to auth-service (8081) for auth.
# A future BFF/API Gateway is needed to fan out to tenant-service,
# analytics-service, and observability-service from a single endpoint.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-strong-secret

# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Grafana / observability embeds (optional)
NEXT_PUBLIC_GRAFANA_URL=
NEXT_PUBLIC_GRAFANA_DASHBOARD_LEADS=
NEXT_PUBLIC_GRAFANA_DASHBOARD_TRAFFIC=
